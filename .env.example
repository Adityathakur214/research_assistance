# ==========================================
# NEXUS RESEARCH AI - ENVIRONMENT VARIABLES
# ==========================================
# Instructions:
# 1. Copy this file and rename it to '.env'
# 2. Replace the placeholder values with your actual API keys and URLs.
# 3. DO NOT commit your actual '.env' file to GitHub.

# --- LLM Provider ---
# Get your Gemini API key from Google AI Studio
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Data Ingestion (n8n) ---
# Replace with your actual n8n webhook URL
N8N_WEBHOOK_URL=http://your_n8n_webhook_url_here/webhook-test/scrape-url